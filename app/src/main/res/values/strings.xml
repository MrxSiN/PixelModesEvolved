    <string name="trigger_movement">Movement</string>
    <string name="trigger_movement_hint">When the phone is on the move, left still or flying</string>
    <string name="movement_intro">On the move and left still use the low-power motion sensor, so they cost almost no battery. Flying reads the barometer and checks position every few minutes.</string>
    <string name="movement_moving">While on the move</string>
    <string name="movement_moving_detail">Walking, running, cycling or in a vehicle. Turns on as soon as motion is detected.</string>
    <string name="movement_still">While left still</string>
    <string name="movement_still_detail">The phone has not moved for 10 minutes, such as resting on a desk or nightstand.</string>
    <string name="movement_flying">While flying</string>
    <string name="movement_flying_detail">On board an aircraft in flight, judged from cabin pressure, speed and altitude. Works with airplane mode on and the phone in a pocket. Driving does not count. Ends after landing.</string>

    <string name="trigger_airplane">Airplane mode</string>
    <string name="trigger_airplane_hint">When airplane mode is on or off</string>
    <string name="airplane_on">While airplane mode is on</string>
    <string name="airplane_on_detail">Turns this mode on as soon as airplane mode is switched on, such as when boarding a flight.</string>
    <string name="airplane_off">While airplane mode is off</string>
    <string name="airplane_off_detail">Turns this mode on whenever airplane mode is off.</string>
    <string name="trigger_headphones">Headphones</string>
    <string name="trigger_headphones_hint">When wired or USB headphones are plugged in or out</string>
    <string name="headphones_connected">While headphones are plugged in</string>
    <string name="headphones_connected_detail">Turns this mode on while wired or USB headphones are connected, whether or not anything is playing. Bluetooth headphones have their own trigger.</string>
    <string name="headphones_disconnected">While no headphones are plugged in</string>
    <string name="headphones_disconnected_detail">Turns this mode on whenever no wired or USB headphones are connected.</string>
    <string name="trigger_power">Power</string>
    <string name="trigger_power_hint">When the phone is charging or unplugged</string>
    <string name="power_connected">While connected to power</string>
    <string name="power_connected_detail">Turns this mode on while the phone is plugged in, on a wireless charger or in a charging dock.</string>
    <string name="power_disconnected">While not connected to power</string>
    <string name="power_disconnected_detail">Turns this mode on whenever the phone is running on its battery.</string>

